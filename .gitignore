node_modules/
dist/
test-results/
coverage/
bench/results/.core.json
*.log

# Copied from node_modules by scripts/copy-rdkit.mjs
public/RDKit_minimal.js
public/RDKit_minimal.wasm
public/ort-wasm-simd-threaded.mjs
public/ocl-resources.json
public/pyodide/

