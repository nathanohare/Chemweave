src/design/icons/mdi.json

# Never commit drawings or reference documents; keep them outside the repo
*.cdxml
*.cdx
*.cds
*.pdf
# except cdxmorph's public example schemes (MIT), the reaction animation's test files
!tests/morph/*.cdxml
!tests/morph/turns/*.cdxml

# OPSIN build folder (see opsin-js/README.md)
opsin-js/target/
# our own ChemDraw test drawing (tests/fixtures/chemdraw-clipboard/README.md)
!tests/fixtures/chemdraw-clipboard/*.cdxml
# files ChemDraw made from it: kept private, never committed
tests/fixtures/chemdraw-private/
# the manuscript check's made-up samples, written by SI Assistant's test makers (tests/si-manuscript-check.test.ts)
!tests/fixtures/manuscript/files/*.pdf
!tests/fixtures/manuscript/files/*.cdxml
!tests/fixtures/manuscript/files/*.cdx
!tests/fixtures/si-import-pdf/*.pdf
!tests/fixtures/si-import/files/*.docx
!tests/fixtures/si-import/spectra/*.docx
