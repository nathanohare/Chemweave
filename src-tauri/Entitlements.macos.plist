<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- What the signed Mac app may use (tauri.macos.conf.json, entitlements). The app is signed with
     the hardened runtime, which turns off the microphone unless it is listed here: Slide Show >
     Record needs it (with NSMicrophoneUsageDescription in Info.macos.plist for the question). -->
<plist version="1.0">
<dict>
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
